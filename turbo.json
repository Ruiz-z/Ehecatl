{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {},
    "test": {
      "cache": false
    },
    "geo#build": {
      "cache": false,
      "outputs": []
    }
  },
  "globalPassThroughEnv": [
    "UV_*",
    "XDG_CACHE_HOME",
    "DATABASE_URL",
    "PORT",
    "HOST"
  ]
}
